<?xml version="1.0" encoding="utf-8"?>
<!--
    Токены сессии в резервную копию не едут.

    Настройки приложения лежат в одном файле: там и токены, и валюта, и кэш правил. Копия
    забирает файл целиком и кладёт его в облако открытым текстом, а токен доступа даёт те же
    права, что пароль. Кэш и валюта восстановятся сами, так что исключается весь файл.

    Этот файл читают Android 24-30; с 31-го действует data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude
            domain="sharedpref"
            path="io.github.youndie.mani_preferences.xml"/>
</full-backup-content>
